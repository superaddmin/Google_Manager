{
  "name": "google-2fa-tool",
  "version": "1.0.0",
  "private": true,
  "description": "自动修改Google账号两步验证(2FA)工具",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "src/",
    "docs/"
