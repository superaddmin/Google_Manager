# Copy to a protected deployment .env; replace every CHANGE_ME / example.invalid.
# Never commit the completed file. Existing deployments MUST retain their keys.
FLASK_ENV=production
ADMIN_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
GMAIL_TOKEN_ENCRYPTION_KEY=CHANGE_ME

# Pin the validated image by digest. This template deliberately cannot deploy.
GOOGLE_MANAGER_IMAGE=registry.example.invalid/google-manager@sha256:CHANGE_ME
PUBLIC_DOMAIN=app.example.invalid

# Keep disabled until the upstream contract and authorized sandbox pass.
RECHARGE_MODE=disabled
RECHARGE_UPSTREAM_URL=
RECHARGE_UPSTREAM_ALLOWED_HOSTS=aichong666.com

# Compose uses the persistent ./instance directory when this is empty.
DATABASE_URL=
GMAIL_CLIENT_SECRET_FILE=/app/credentials.json
GMAIL_REDIRECT_URI=https://app.example.invalid/api/gmail/oauth/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
PROXY=
HEADLESS=true

# This gateway must match the checked-in Compose network and actual host proxy.
TRUSTED_PROXY_CIDRS=172.30.8.1/32
GUNICORN_BIND=0.0.0.0:8002
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# The backup key is supplied separately as a protected --key-file, never here.
